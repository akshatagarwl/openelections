# Content-hashed build assets: cache forever (same rule vinext generates by default).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed brand files: cache for a day, serve stale while revalidating for a week.
/mark.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/mark-inverted.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
